# ==============================================================================
# .gitignore for Straggler Detection & Speculative Execution Research Suite
# ==============================================================================

# Python Virtual Environments
.venv/
venv/
ENV/
env/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment Configuration & Local Secrets
.env
.env.local

# Excluded Directories per configuration
data/
events/
docs/

# Raw Spark Run Logs and Execution Event Traces
results/**/logs/
results/**/eventlogs/

# Operating System & IDE junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~
*.swp
*.swo
.vscode/
.idea/

# Large Archives
*.zip
*.tar.gz
*.tgz
